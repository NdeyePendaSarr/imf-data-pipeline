# Modèle de configuration locale.
# Copier ce fichier en .env (cp .env.example .env), puis adapter les valeurs.
# Le fichier .env n'est jamais versionné.

# Utilisateur administrateur de PostgreSQL
POSTGRES_USER=imf_admin

# Mot de passe de cet utilisateur : à remplacer impérativement dans .env
POSTGRES_PASSWORD=a_changer

# Hôte vu depuis le poste (scripts Python, tests, client graphique)
POSTGRES_HOST=localhost

# Port exposé sur le poste (5432 est réservé au PostgreSQL local)
POSTGRES_PORT=5433

# Base opérationnelle simulée, remplie par le générateur (python -m generator)
POSTGRES_DB_OPS=imf_ops

# Entrepôt de données, alimenté par l'ingestion (python -m ingestion) et transformé par dbt
# (dbt/profiles.yml lit aussi POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER et POSTGRES_PASSWORD)
POSTGRES_DB_DWH=imf_dwh

# --- Airflow (phase 7, make airflow-up). Valeurs à générer, jamais versionnées.
# Exercice planifié par le DAG imf_quotidien (01/01 au 31/12 ; 2025 par défaut).
IMF_EXERCICE=2025
# Utilisateur propriétaire des fichiers écrits par les conteneurs (sortie de `id -u`).
AIRFLOW_UID=1000
# Mot de passe de la base de métadonnées d'Airflow (service airflow-db).
AIRFLOW_DB_PASSWORD=a_changer
# Clé Fernet (chiffrement des connexions) : 32 octets aléatoires en base64 urlsafe.
AIRFLOW_FERNET_KEY=a_generer
# Secrets de signature des jetons de l'API (JWT) et de l'api-server.
AIRFLOW_JWT_SECRET=a_generer
AIRFLOW_API_SECRET_KEY=a_generer
# Compte administrateur de l'interface (http://localhost:8080).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=a_changer

# --- Power BI (phase 8, make powerbi-role). Rôle powerbi_lecteur, lecture seule sur gold et
# audit ; Power BI se connecte à localhost:POSTGRES_PORT, base imf_dwh, avec ce rôle.
POWERBI_PASSWORD=
# BigQuery (phase 9) : ID du projet Google Cloud (bac à sable) ; région fixe, ne jamais la changer (L5)
BQ_PROJECT=
BQ_LOCATION=EU
